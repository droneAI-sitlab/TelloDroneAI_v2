# Example .env for TelloDroneAI_v2
# Copy to .env and edit values for your environment

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=change-me-in-production

# Drone / Tello
DRONE_WIFI_SSID=TELLO-XXXXXX
DRONE_IP=192.168.10.1
DRONE_PORT=8889
VIDEO_PORT=11111
WIFI_CONNECT_TIMEOUT=15

# Frame processing
FRAME_WIDTH=960
FRAME_HEIGHT=720
JPEG_QUALITY=80
ENABLE_CONTRAST=True
CONTRAST_ALPHA=1.05
CONTRAST_BETA=2
TARGET_FPS=30.0

# OCR
OCR_ENABLED=True
OCR_SERVER_URL=http://192.168.1.100:8000
OCR_TIMEOUT=30
OCR_INTERVAL_SECONDS=5
OCR_JPEG_QUALITY=85
OCR_MIN_CONFIDENCE=0.0

# Voice / Vosk
VOICE_MIN_INPUT_RMS=0.02
VOICE_MIN_FINAL_CHARS=4
VOICE_MIN_AVG_CONFIDENCE=0.82
VOICE_DEDUPE_WINDOW_SECONDS=2.2

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=functiongemma_tello_current
OLLAMA_TIMEOUT=30
OLLAMA_TEMPERATURE=0

# Command buffer
COMMAND_BUFFER_DELAY_SECONDS=2.0
COMMAND_BUFFER_MAX_SIZE=50
KEEPALIVE_COOLDOWN_SECONDS=5.0
KEEPALIVE_USE_NO_RESPONSE=False

# Logging
LOG_MAX_ENTRIES=100
